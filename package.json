{
  "name": "medbridge-global",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "author": "Ashirwad Kumar",
  "copyright": "Copyright (c) 2026 Ashirwad Kumar. All Rights Reserved.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "web": "npm run dev --workspace=@medbridge/web",
    "web:build": "npm run build --workspace=@medbridge/web",
    "build": "npm run build --workspace=@medbridge/web",
    "mobile": "npx expo start apps/mobile -c",
    "mobile:tunnel": "npx expo start apps/mobile --tunnel ngrok -c",
    "mobile:ios": "npm run ios --workspace=@medbridge/mobile",
    "mobile:android": "npm run android --workspace=@medbridge/mobile",
    "backend": "npm run dev --workspace=@medbridge/backend",
    "backend:start": "npm run start --workspace=@medbridge/backend",
    "dev": "npm run dev --workspace=@medbridge/web",
    "lint": "npm run lint --workspace=@medbridge/web",
    "security:check": "node scripts/security-check.js"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "typescript": "^5"
  },
  "overrides": {
    "react-native": "0.88.1",
    "react-native-screens": "~4.30.1",
    "react-native-safe-area-context": "~5.11.1",
    "expo-font": "~58.0.11"
  }
}
