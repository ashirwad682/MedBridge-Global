{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@medbridge/types": ["../packages/types/src"],
      "@medbridge/constants": ["../packages/constants/src"],
      "@medbridge/validation": ["../packages/validation/src"],
      "@medbridge/config": ["../packages/config/src"]
    }
  },
  "include": ["**/*.ts"]
}

