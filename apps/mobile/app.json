{
  "expo": {
    "name": "MedBridge Global",
    "slug": "medbridge-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "medbridge",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17151F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medbridge.global"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17151F"
      },
      "package": "com.medbridge.global"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

