# MedBridge Global Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real secrets to version control.

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=medbridge

# JWT Signing Secret (Generate with: openssl rand -hex 32)
AUTH_SECRET=your_super_secret_jwt_key_here

# Backend Service Configuration
BACKEND_PORT=5001
PORT=5001

# Public Web Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mobile API Configuration
EXPO_PUBLIC_API_URL=http://localhost:5001

# Optional GitHub Token for Repository Clone & Traffic Monitoring (Admin Dashboard)
# Requires repo read:traffic permissions
GITHUB_REPO_TOKEN=
GITHUB_REPO_OWNER=ashirwad682
GITHUB_REPO_NAME=MedBridge-Global
