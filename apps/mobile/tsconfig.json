{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@medbridge/types": ["../../packages/types/src"],
      "@medbridge/constants": ["../../packages/constants/src"],
      "@medbridge/validation": ["../../packages/validation/src"],
      "@medbridge/api": ["../../packages/api/src"],
      "@medbridge/config": ["../../packages/config/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

